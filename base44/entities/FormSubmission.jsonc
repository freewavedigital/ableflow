{
  "name": "FormSubmission",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "FormTemplate this was submitted against"
    },
    "template_version": {
      "type": "number",
      "description": "Snapshot of the template version at time of submission \u2014 preserves history across template upgrades"
    },
    "form_type": {
      "type": "string",
      "enum": [
        "website",
        "job",
        "agreement"
      ],
      "description": "Denormalised for fast filtering without joining FormTemplate"
    },
    "related_object": {
      "type": "string",
      "enum": [
        "Lead",
        "Job",
        "Lead_or_Job"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "web",
        "mobile",
        "internal",
        "api"
      ],
      "default": "internal",
      "description": "How the submission was made"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed",
        "signed",
        "converted"
      ],
      "default": "draft"
    },
    "linked_lead_id": {
      "type": "string",
      "description": "Lead record this submission is attached to (if applicable)"
    },
    "linked_job_id": {
      "type": "string",
      "description": "Job record this submission is attached to (if applicable)"
    },
    "linked_client_id": {
      "type": "string",
      "description": "Client record for context/reporting"
    },
    "branch_id": {
      "type": "string"
    },
    "submitted_by": {
      "type": "string",
      "description": "User email, or 'anonymous' for public website submissions"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp of when the form was submitted"
    },
    "field_values": {
      "type": "object",
      "description": "Flat map of field_key \u2192 value for all completed fields"
    },
    "section_instances": {
      "type": "array",
      "description": "For repeatable sections: array of { section_id, instance_index, field_values } objects",
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string"
          },
          "instance_index": {
            "type": "number"
          },
          "field_values": {
            "type": "object"
          }
        }
      }
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of photos captured during submission"
    },
    "signature_record_id": {
      "type": "string",
      "description": "Reference to the SignatureRecord if a signature was captured"
    },
    "converted_lead_id": {
      "type": "string",
      "description": "For website forms: the Lead record created from this submission"
    },
    "reviewer_notes": {
      "type": "string",
      "description": "Admin notes added during review"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "template_id",
    "form_type",
    "related_object",
    "source"
  ]
}