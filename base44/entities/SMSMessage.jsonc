{
  "name": "SMSMessage",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "lead",
        "job",
        "client"
      ],
      "description": "What record this SMS is attached to"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the lead, job, or client"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to the client for reporting"
    },
    "branch_id": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "outbound"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number sent to or received from"
    },
    "content": {
      "type": "string",
      "description": "Message body text"
    },
    "sent_by": {
      "type": "string",
      "description": "Staff member email who sent the message"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "read",
        "failed"
      ],
      "default": "sent"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if delivery failed"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "reminder",
        "confirmation",
        "quote",
        "update",
        "follow_up",
        "emergency",
        "general"
      ],
      "default": "general"
    },
    "template_key": {
      "type": "string",
      "description": "e.g. 'appointment_reminder', 'quote_sent'"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "phone_number",
    "content"
  ]
}