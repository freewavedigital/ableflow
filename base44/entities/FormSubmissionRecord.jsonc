{
  "name": "FormSubmissionRecord",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "FormTemplate this was submitted against"
    },
    "template_version": {
      "type": "number",
      "description": "Snapshot of the template version at time of submission"
    },
    "form_type": {
      "type": "string",
      "enum": [
        "website",
        "job",
        "agreement"
      ]
    },
    "related_object": {
      "type": "string",
      "enum": [
        "Lead",
        "Job",
        "Lead_or_Job"
      ]
    },
    "linked_entity_type": {
      "type": "string",
      "enum": [
        "lead",
        "job",
        "client",
        "none"
      ],
      "default": "none"
    },
    "linked_entity_id": {
      "type": "string"
    },
    "branch_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed",
        "signed",
        "converted"
      ],
      "default": "draft"
    },
    "submitted_by": {
      "type": "string",
      "description": "User email or 'anonymous' for public website forms"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "field_values": {
      "type": "object",
      "description": "Flat map of field_id -> value"
    },
    "signature_url": {
      "type": "string",
      "description": "For agreement forms: URL of the captured signature image"
    },
    "signed_date": {
      "type": "string",
      "format": "date-time"
    },
    "signer_name": {
      "type": "string"
    },
    "signer_email": {
      "type": "string"
    },
    "converted_lead_id": {
      "type": "string",
      "description": "For website submissions: if converted to a Lead record"
    },
    "reviewer_notes": {
      "type": "string"
    }
  },
  "required": [
    "template_id",
    "form_type",
    "related_object"
  ]
}