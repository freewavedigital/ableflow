{
  "name": "PhoneCall",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "lead",
        "job",
        "client"
      ],
      "description": "What record this call is attached to"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the lead, job, or client"
    },
    "client_id": {
      "type": "string",
      "description": "Reference to the client for reporting"
    },
    "branch_id": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "outbound"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number called or received from"
    },
    "caller_name": {
      "type": "string",
      "description": "Name of the person calling (for inbound)"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Length of call in seconds"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call started"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the call ended"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "missed",
        "rejected",
        "no_answer"
      ],
      "default": "completed"
    },
    "initiated_by": {
      "type": "string",
      "description": "Staff member email who made/received the call"
    },
    "notes": {
      "type": "string",
      "description": "Summary of call discussion"
    },
    "recording_url": {
      "type": "string",
      "description": "URL to call recording (audio file)"
    },
    "transcript": {
      "type": "string",
      "description": "Call transcript text"
    },
    "transcription_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags like 'callback_needed', 'urgent', 'follow_up'"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "scheduled_job",
        "quote_sent",
        "agreement_sent",
        "info_provided",
        "follow_up_required",
        "other"
      ],
      "description": "What was the result of this call"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "phone_number"
  ]
}