{
  "name": "Client",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "pool_company",
        "body_corporate",
        "other"
      ],
      "default": "residential",
      "description": "Client type"
    },
    "company_name": {
      "type": "string",
      "description": "Company name if commercial client"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "secondary_phone": {
      "type": "string"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "phone",
        "email",
        "sms"
      ],
      "default": "phone"
    },
    "branch_id": {
      "type": "string",
      "description": "Primary branch this client is associated with"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags like VIP, repeat, referral source etc"
    },
    "previous_customer": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone"
  ]
}